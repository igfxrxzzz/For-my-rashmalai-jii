<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Rasmalai! 🎂</title>
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #fceabb, #f8b500);
            text-align: center;
            overflow-x: hidden;
        }
        .container { padding: 20px; }
        h1 { color: #d35400; font-size: 3rem; margin-top: 50px; text-shadow: 2px 2px #fff; }
        .nickname { color: #e67e22; font-weight: bold; font-style: italic; }
        
        /* Game Styles */
        #game-area {
            width: 100%;
            height: 400px;
            background: rgba(255, 255, 255, 0.3);
            border: 2px dashed #d35400;
            position: relative;
            margin: 20px auto;
            max-width: 600px;
            border-radius: 15px;
            overflow: hidden;
            display: none;
        }
        .rasmalai-icon {
            width: 60px;
            cursor: pointer;
            position: absolute;
            transition: 0.2s;
        }
        #score { font-size: 1.2rem; font-weight: bold; color: #d35400; }

        /* Button Styles */
        .btn {
            background: #d35400;
            color: white;
            padding: 15px 30px;
            border: none;
            border-radius: 25px;
            font-size: 1.1rem;
            cursor: pointer;
            margin: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .btn:hover { background: #e67e22; }

        /* Hidden Gift Section */
        #gift-section { display: none; margin-top: 30px; animation: fadeIn 2s; }
        @keyframes fadeIn { from {opacity: 0;} to {opacity: 1;} }
        
        ul { list-style: none; padding: 0; display: inline-block; text-align: left; }
        li { font-size: 1.2rem; margin: 10px 0; color: #2c3e50; font-weight: 500; }
    </style>
</head>
<body>

    <div class="container">
        <h1>Happy Birthday, <span class="nickname">Rasmalai</span>! 🍮</h1>
        <p style="font-size: 1.2rem;">Today is all about you! But first, you have to win your treat. 😉</p>
        
        <button class="btn" id="start-btn" onclick="startGame()">Play "Catch the Rasmalai"</button>

        <div id="game-area">
            <p id="score">Score: 0 / 5</p>
            <div id="target" class="rasmalai-icon" onclick="catchRasmalai()">🍮</div>
        </div>

        <div id="gift-section">
            <h2>Yay! You won! 🎉</h2>
            <p>Since you caught the Rasmalai, here are the 5 things I like most about you:</p>
            <ul>
                <li>1. Eating u (The sweetest treat! 😉)</li>
                <li>2. Talking with u (Never gets old)</li>
                <li>3. Your vibe (Whatever it is, it's working)</li>
                <li>4. Challenging me (Like you always do)</li>
                <li>5. <strong>YOU.</strong> (Simply because you're you)</li>
            </ul>
            <br>
            <p style="font-weight: bold; color: #d35400; font-size: 1.5rem;">Have the best day ever! ❤️</p>
        </div>
    </div>

    <script>
        let score = 0;
        const target = document.getElementById('target');
        const gameArea = document.getElementById('game-area');
        const giftSection = document.getElementById('gift-section');
        const scoreDisplay = document.getElementById('score');

        function startGame() {
            document.getElementById('start-btn').style.display = 'none';
            gameArea.style.display = 'block';
            moveTarget();
        }

        function moveTarget() {
            const x = Math.random() * (gameArea.clientWidth - 60);
            const y = Math.random() * (gameArea.clientHeight - 60);
            target.style.left = x + 'px';
            target.style.top = y + 'px';
        }

        function catchRasmalai() {
            score++;
            scoreDisplay.innerText = "Score: " + score + " / 5";
            if (score >= 5) {
                gameArea.style.display = 'none';
                giftSection.style.display = 'block';
                launchConfetti();
            } else {
                moveTarget();
            }
        }

        // Optional: Simple Confetti effect alert
        function launchConfetti() {
            alert("Happy Birthday, Rasmalai! 🥳");
        }
    </script>
</body>
</html>
